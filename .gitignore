# ============================================================
# PedigrAPP - files that must never be published
# ============================================================

# Clinical/local family data
/data/**
!/data/.htaccess
!/data/.gitkeep

# Non-public examples and test material
/examples/
/tests/
/test/

# Credentials and private configuration
.env
.env.*
.htpasswd
.htpasswd.*
*.pem
*.key
*.p12
*.pfx
*.cnf
*.kdbx

# Databases, dumps and logs
*.sql
*.sqlite
*.sqlite3
*.db
*.dump
*.log

# Python/test/editor/system caches
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
.DS_Store
Thumbs.db
*.bak
*.tmp
*.old
*.orig
*.rej
*.swp
*.swo
*~

# Local archives and packages
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# Local installations and internal validation reports
/_v*_test/
/*_VALIDATION.md
/DEPLOYMENT_*.md
/I18N_REVIEW_*.md
/V12_CONSOLIDACION_LOCAL.md
*.sqlite*
*.backup
*.backup.*
*.log.*
*.tmp.*
*.bak.*

# Internal translation validation artifacts
/scripts/audit_untranslated.py
/scripts/check_i18n.py
/scripts/i18n_*.json
